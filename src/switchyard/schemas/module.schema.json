{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vicberger-com/hermes-switchyard/schemas/module.schema.json",
  "title": "Switchyard module manifest (module.toml)",
  "description": "Normative. switchyard.manifest supports exactly the keywords used here and adds the cross-field rules listed in its docstring.",
  "type": "object",
  "required": ["schema", "module", "capabilities", "lifecycle"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "module": {
      "type": "object",
      "required": ["id", "name", "version", "license", "license_class", "summary", "requires_core", "isolation", "entry"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$"},
        "name": {"type": "string"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
        "license": {"type": "string", "description": "SPDX identifier, or 'Proprietary' for a closed-source connector target."},
        "license_class": {"type": "string", "enum": ["open", "proprietary-connector"]},
        "summary": {"type": "string"},
        "requires_core": {"type": "string"},
        "isolation": {"type": "string", "enum": ["in-process", "subprocess"]},
        "entry": {"type": "string", "pattern": "^[a-z_][a-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"}
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["request"],
      "additionalProperties": false,
      "properties": {
        "request": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "fs.read", "fs.write", "net.outbound", "secrets.read", "process.spawn",
              "hermes.hooks", "hermes.tools", "hermes.config.write", "hermes.delegation", "hermes.output",
              "llm.free", "llm.paid", "ui.panel", "schedule", "notify", "core.read"
            ]
          }
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "net_hosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:localhost|[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+)(?::[0-9]{1,5})?$"}
        },
        "secrets": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hooks": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "tools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "commands": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "panels": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "policies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "triggers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "log_streams": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "secret_backends": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"}
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["activation"],
      "additionalProperties": false,
      "properties": {
        "activation": {"type": "string", "enum": ["manual", "auto", "disabled"]},
        "idle_stop_seconds": {"type": "integer", "minimum": 0}
      }
    },
    "update": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string", "enum": ["bundled", "git"]},
        "url": {"type": "string", "pattern": "^https://"},
        "ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "channel": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,99}$"}
      }
    }
  }
}
